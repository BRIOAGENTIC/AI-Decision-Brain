# Copy this file to ".env" and fill in real values.

# Required: secret expected in the "x-api-key" header of every POST /judge request.
API_SECRET=replace-with-a-long-random-string

# Required: Google Gemini API key (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY=replace-with-your-gemini-key

# Optional: port to listen on (defaults to 3000).
PORT=3000